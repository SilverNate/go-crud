# Copy to .env for local use. .env is git-ignored; never commit real credentials.
# Loaded automatically by `docker compose`; for `go run`, export it into your shell (see README).
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug                  # debug | info | warn | error
WORKER_QUEUE_SIZE=64

# --- Local (non-Docker) run: `go run ./cmd/api` ---
STORAGE_DRIVER=memory            # memory | postgres
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/taskdb?sslmode=disable

# --- Docker Compose (docker compose up) ---
# Compose builds DATABASE_URL itself using the host "db"; these three configure Postgres and the API user.
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me-use-a-long-random-value   # avoid @ : / ? # (or percent-encode)
POSTGRES_DB=taskdb
API_PORT=8080

# Used ONLY by `go test` for PostgreSQL integration tests.
# The database name must contain "test"; a throwaway schema is created and dropped per run.
# TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/taskdb_test?sslmode=disable
